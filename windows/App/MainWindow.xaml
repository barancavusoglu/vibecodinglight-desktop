   <Grid x:Name="NoticePanel" Margin="0,0,0,10"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Notice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Notice" Text="" Foreground="{DynamicResource Notice}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="DismissNotice" Grid.Column="1" Content="Tamam" Click="DismissNotice_Click" Padding="10,6" Margin="0" VerticalAlignment="Center" ToolTip="Bildirimi kapat"/></Grid>
   <DockPanel><TextBlock DockPanel.Dock="Right" Text="● Yerel" Foreground="{DynamicResource Muted}" FontSize="11"/><Ellipse x:Name="DeviceDot" Width="6" Height="6" Fill="#A9B0A9" Margin="0,0,7,0"/><TextBlock x:Name="DeviceText" Text="Cihaz aranıyor" Foreground="{DynamicResource Muted}" FontSize="11"/></DockPanel>
  </StackPanel>
 </Grid>
</Window>
