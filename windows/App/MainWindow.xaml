   <Trigger Property="Tag" Value="unhealthy"><Setter TargetName="Surface" Property="BorderBrush" Value="#D96653"/><Setter TargetName="Surface" Property="Effect"><Setter.Value><DropShadowEffect Color="#E36E5C" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/></Setter.Value></Setter></Trigger>
