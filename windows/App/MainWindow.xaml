  <DrawingBrush x:Key="ZebraBrush" TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute" Viewbox="0,0,18,18" ViewboxUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing><GeometryDrawing.Pen><Pen Brush="{DynamicResource Muted}" Thickness="5"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="-9,9" EndPoint="9,-9"/><LineGeometry StartPoint="0,18" EndPoint="18,0"/><LineGeometry StartPoint="9,27" EndPoint="27,9"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush>
  <Style x:Key="ConnectionCard" TargetType="ContentControl"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid Margin="8,8,8,14">
