<Window x:Class="AiLight.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AiLight.App" Title="VibeCodingLight" Icon="Assets/VibeCodingLight.ico" Width="460" Height="760" MinWidth="420" MinHeight="600" WindowStartupLocation="CenterScreen" Background="{DynamicResource Page}" FontFamily="Segoe UI" Foreground="{DynamicResource Ink}" FontSize="13" ResizeMode="CanResize" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary>
