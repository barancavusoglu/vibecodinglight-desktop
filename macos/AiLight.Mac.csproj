<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion><AssemblyName>VibeCodingLight</AssemblyName><Product>VibeCodingLight</Product></PropertyGroup>
 <ItemGroup><PackageReference Include="System.IO.Ports" Version="10.0.0"/><PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3"/></ItemGroup>
 <ItemGroup><ProjectReference Include="../desktop/AiLight.Desktop.csproj"/><EmbeddedResource Include="../windows/App/opencode-plugin.js" LogicalName="AiLight.OpenCodePlugin"/></ItemGroup>
 <ItemGroup><Compile Include="../shared/SerialRobotLink.cs" Link="Transport/SerialRobotLink.cs"/></ItemGroup>
 <Target Name="CompileBluetoothHelper" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
  <Exec Command="xcrun swiftc -swift-version 5 -O -framework CoreBluetooth -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker &quot;$(MSBuildProjectDirectory)/BluetoothHelper.plist&quot; &quot;$(MSBuildProjectDirectory)/BluetoothHelper.swift&quot; -o &quot;$(TargetDir)VibeCodingLight.Bluetooth&quot;"/>
 </Target>
</Project>
